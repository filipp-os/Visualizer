[Desktop Entry]
Type=Application
Name=Pedro Visualizer
Comment=Path visualizer for Pedro Pathing
Exec=bash -c 'cd "$(dirname "$(readlink -f %k)")" && exec ./start-visualizer.sh'
Icon=pedro-visualizer
Terminal=true
Categories=Development;Education;

# Linux only.
# The easiest path: run  ./start-visualizer.sh  once from a terminal. That
# installs a "Pedro Visualizer" entry (with the duck icon) into your
# application menu, which you can then pin to the dock.
#
# To use THIS file directly instead: chmod +x it, double-click, and choose
# "Trust" / "Allow Launching" if prompted. The icon shows once the .sh above
# has run at least once (it installs the icon named "pedro-visualizer").
